source "Kconfig.zephyr"

menu "Nordic HIDS BLE GATT mouse service sample"

config BT_HIDS_SECURITY_ENABLED
	bool "Enable security"
	default y
	imply BT_PRIVACY
	select BT_SMP
	select BT_SETTINGS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select SETTINGS
	imply ZMS if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
	imply NVS if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
	help
	  "Enable BLE security for the HIDS service"

config BT_DIRECTED_ADVERTISING
	bool "Enable directed advertising"
	default y
	depends on BT_HIDS_SECURITY_ENABLED

config MEMFAULT_FIXED_PARTITION_COREDUMP
	bool "Use fixed partition storage for Memfault coredumps"
	depends on MEMFAULT
	depends on FLASH
	depends on FLASH_MAP
	depends on SOC_FLASH_NRF_RRAM
	select NRFX_RRAMC
	select MEMFAULT_COREDUMP_STORAGE_CUSTOM
	help
	  Use the memfault_coredump_partition fixed partition for coredump storage.

endmenu
